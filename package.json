{
  "name": "dsh-session-monitor",
  "version": "0.11.1",
  "description": "Multi-grid live monitor for every active and recently used session: transcript, pending questions and prompts, all in one panel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icrefin/dsh-session-monitor.git"
  },
  "homepage": "https://github.com/icrefin/dsh-session-monitor#readme",
  "bugs": {
    "url": "https://github.com/icrefin/dsh-session-monitor/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "session",
    "sessions",
    "monitor",
    "dashboard",
    "multi-session",
    "session-monitor",
    "sidebar"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "pack": "pnpm build && pnpm pack --pack-destination dist"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@types/node": "^24.19.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "jsdom": "^30.1.1",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.2",
    "unrun": "^0.3.1",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@11.20.0"
}
